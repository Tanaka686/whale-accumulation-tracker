{
  "name": "Whale Accumulation Tracker",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12",
  "postCreateCommand": "pip install --quiet uv && uv venv --python 3.12 .venv && uv pip install -e '.[dev,article-kit]'",
  "postStartCommand": "nohup uv run uvicorn app.server:app --host 0.0.0.0 --port 8000 > /tmp/whale-app.log 2>&1 &",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Whale Accumulation Tracker",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
